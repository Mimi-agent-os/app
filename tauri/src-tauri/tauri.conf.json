{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "mimi",
    "version": "0.1.0",
    "identifier": "os.mimi.app",
    "build": {
        "frontendDist": "../panel",
        "devUrl": "http://127.0.0.1:1420/app/"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "mimi-os",
                "url": "index.html",
                "width": 1280,
                "height": 840,
                "minWidth": 360,
                "minHeight": 480,
                "dragDropEnabled": false,
                "useHttpsScheme": false
            }
        ],
        "security": {
            "capabilities": [
                "main"
            ],
            "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws: wss: http: https:; frame-src 'self' mimiapp:; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "minimumSystemVersion": "13.3"
        }
    }
}
